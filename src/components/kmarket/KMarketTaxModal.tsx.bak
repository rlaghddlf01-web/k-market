                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 text-emerald-900/80 dark:text-emerald-300/80 text-[11px] leading-relaxed">
                  <div className="flex items-start gap-1.5">
                    <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                    <span><strong>{t('?좉껐??鍮꾩슜 0??')}</strong> {t('援?꽭泥?뿉???듭옣?쇰줈 ?섍툒湲덉씠 ?낃툑???꾩뿉留??깃났 ?섏닔猷뚭? 諛쒖깮?⑸땲??')}</span>
                  </div>
                  <div className="flex items-start gap-1.5">
                    <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                    <span><strong>{t('?섍툒??0?????꾩븸 臾대즺:')}</strong> {t('議고쉶 寃곌낵 ?섍툒 ??곸씠 ?꾨땲嫄곕굹 0?먯씤 寃쎌슦 怨좉컼 遺?닿툑? 0?먯엯?덈떎.')}</span>
                  </div>
                </div>
              </div>

              {/* ?좎껌???뺣낫 ?낅젰 ??*/}
              <div className="space-y-3">
                <h3 className="text-xs font-bold text-slate-800 dark:text-slate-200">
                  {t('?섍툒湲??덈궡 諛??묒닔 ?뺣낫 ?낅젰')}
