                    const visaKey = visa.code.toLowerCase().replace(/[^a-z0-9]/g, '_');
                    const visaBadge = t(`visa_${visaKey}_badge` as any) || visa.badge;
                    const visaName = t(`visa_${visaKey}_name` as any) || visa.name;

