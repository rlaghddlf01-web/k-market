                  </label>
                  <div className="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
                    {[
                      { code: 'VN', label: '踰좏듃???눤?눛' },
                      { code: 'CN', label: '以묎뎅 ?눊?눛' },
                      { code: 'TH', label: '?쒓뎅 ?눢?눑' },
                      { code: 'UZ', label: '?곗쫰踰??눣?눨' },
                      { code: 'PH', label: '?꾨━? ?눝?눑' },
