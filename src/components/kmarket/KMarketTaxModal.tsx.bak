                  </span>
                </div>

                <div className="space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
                  <div className="flex justify-between">
                    <span className="text-slate-400">{t('援?꽭(?뚮뱷?? ?섍툒 ?덉긽遺?)}</span>
                    <span className="font-semibold text-slate-800 dark:text-slate-200">
                      {result.nationalTaxRefund.toLocaleString()}{t('??(??쒕?援??먰솕)')}
                    </span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">{t('吏諛⑹냼?앹꽭 ?섍툒 ?덉긽遺?(10%)')}</span>
                    <span className="font-semibold text-slate-800 dark:text-slate-200">
                      {result.localTaxRefund.toLocaleString()}{t('??(??쒕?援??먰솕)')}
                    </span>
                  </div>
                  <div className="flex justify-between text-orange-600 font-extrabold pt-1 border-t border-slate-200/60 dark:border-gray-700">
                    <span>{t('珥??덉긽 ?섍툒 ?섎졊??)}</span>
                    <span className="text-base">{result.estimatedTotalRefund.toLocaleString()}{t('??(??쒕?援??먰솕)')}</span>
                  </div>
                </div>
              </div>

              {/* ?꾨텋???좉껐??0?? ?덉떖 蹂댁쬆 ?뺤콉 諛곕꼫 */}
              <div className="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 space-y-2 text-xs">
                <div className="flex items-center gap-2 font-bold text-emerald-800 dark:text-emerald-300">
                  <ShieldCheck className="w-4 h-4 text-emerald-600" />
                  <span>{t('100% ?꾨텋??& ?덉떖 蹂댁쬆 ?뺤콉')}</span>
