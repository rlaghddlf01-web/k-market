                <div className="flex justify-between text-[11px] text-slate-400 font-medium">
                  <span>1 {t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)}</span>
                  <span>2 {t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)}</span>
                  <span>3 {t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)} ({t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)})</span>
                  <span>4 {t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)}</span>
                  <span>5 {t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)} ({t('?덈궡 ?댁슜???뺤씤??二쇱꽭??)})</span>
                </div>
              </div>

              {/* 3. ???됯퇏 湲됱뿬 ?щ씪?대뜑 */}
